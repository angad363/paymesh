<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath/>
	</parent>
	<groupId>com.paymesh</groupId>
	<artifactId>backend</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name/>
	<description/>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>21</java.version>
	</properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- Security: BCryptPasswordEncoder for password hashing, and (from the next
             checkpoint on) the filter chain that enforces the tokens this service issues.
             NOTE: adding this starter switches on Spring Security's auto-configuration, which
             locks down EVERY endpoint by default. SecurityConfiguration re-opens them, because
             applying tokens to the merchant API is deliberately a later change. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- JWT signing and verification: NimbusJwtEncoder mints access tokens,
             NimbusJwtDecoder verifies them. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-oauth2-jose</artifactId>
        </dependency>

        <!-- BearerTokenAuthenticationFilter and friends: reads the Authorization header,
             hands the token to our JwtDecoder, and populates the SecurityContext. Using the
             framework's filter rather than a hand-rolled one means bearer-token parsing,
             401 vs 403 semantics and the WWW-Authenticate header are all standard behaviour
             we neither wrote nor have to keep correct. Versions come from the Spring Security
             BOM the Boot parent imports. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-oauth2-resource-server</artifactId>
        </dependency>

        <!-- Persistence: Spring Data JPA + PostgreSQL driver + Flyway migrations -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Flyway libraries: the migration engine + the PostgreSQL dialect module. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Spring Boot 4 split auto-configurations into per-technology modules.
             flyway-core alone gives the classes but NOT the auto-config that runs
             migrations at startup. This module (FlywayAutoConfiguration) is what
             actually wires Flyway to the datasource and calls migrate() on boot. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- SecurityMockMvcRequestPostProcessors.jwt(): builds an authenticated request with
             chosen claims, so a test can assert what a caller with a given merchant scope may
             see without minting and signing a real token. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers: spin up a real, throwaway PostgreSQL in Docker for integration tests.
             Versions are managed by the Spring Boot parent BOM. Not exercised yet (no integration
             tests this checkpoint) - added so the persistence foundation is ready for them. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<!-- application.yaml deliberately ships no secrets, so a plain `mvn spring-boot:run`
					     would (correctly) refuse to start. This turns on application-dev.yaml, which
					     carries the throwaway local values. It applies to the `run` goal only: the jar
					     this plugin packages has no profile baked in, so a deployment still has to
					     supply its own secrets. -->
					<profiles>
						<profile>dev</profile>
					</profiles>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
