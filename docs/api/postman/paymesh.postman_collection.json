{
  "info": {
    "name": "PayMesh API",
    "description": "PayMesh Payment-as-a-Service API.\n\nSet `baseUrl` (defaults to http://localhost:8080). Run the folders top to bottom: onboarding creates a merchant, Identity & Auth attaches a user and captures a token, and Authenticated access uses it.\n\nCapabilities covered: Identity & Auth, Merchant, Customer.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "merchantId",
      "value": ""
    },
    {
      "key": "authEmail",
      "value": ""
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "firstRefreshToken",
      "value": ""
    },
    {
      "key": "wrongPasswordBody",
      "value": ""
    },
    {
      "key": "customerId",
      "value": ""
    },
    {
      "key": "otherEmail",
      "value": ""
    },
    {
      "key": "otherMerchantId",
      "value": ""
    },
    {
      "key": "otherUserEmail",
      "value": ""
    },
    {
      "key": "otherAccessToken",
      "value": ""
    },
    {
      "key": "forgedToken",
      "value": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJ1c3JfMTExMTExMTEtMTExMS00MTExLTgxMTEtMTExMTExMTExMTExIiwiaXNzIjoicGF5bWVzaCIsImV4cCI6OTk5OTk5OTk5OX0.ZmFrZS1zaWduYXR1cmUtbm90LXByb2R1Y2VkLWJ5LXRoZS1yZWFsLWtleQ"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Actuator health",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "pm.test('UP', () => pm.expect(pm.response.json().status).to.eql('UP'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Merchant (public onboarding)",
      "description": "Creating a merchant is the signup step and needs no token -- it precedes having an account at all. Reading one does need a token; those requests live in 'Authenticated access' below, after a session exists.",
      "item": [
        {
          "name": "Register merchant",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"businessName\": \"  FreshBrew Cafe  \",\n  \"email\": \" Owner@FreshBrew.Example \",\n  \"country\": \"in\",\n  \"defaultCurrency\": \"inr\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/merchants",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "merchants"
              ]
            },
            "description": "Input is deliberately untrimmed and mixed-case: the domain trims the business name, lowercases the email, and uppercases country and currency."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Unique email per run so the unique constraint does not fail a repeat run.",
                  "pm.collectionVariables.set('runEmail', 'owner+' + Date.now() + '@freshbrew.example');",
                  "const body = JSON.parse(pm.request.body.raw);",
                  "body.email = pm.collectionVariables.get('runEmail');",
                  "pm.request.body.raw = JSON.stringify(body);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('opaque prefixed id', () => pm.expect(body.id).to.match(/^mrc_[0-9a-f-]{36}$/));",
                  "pm.test('business name trimmed', () => pm.expect(body.businessName).to.eql('FreshBrew Cafe'));",
                  "pm.test('email lowercased', () => pm.expect(body.email).to.eql(body.email.toLowerCase()));",
                  "pm.test('country uppercased', () => pm.expect(body.country).to.eql('IN'));",
                  "pm.test('currency uppercased', () => pm.expect(body.defaultCurrency).to.eql('INR'));",
                  "pm.test('starts pending verification', () => pm.expect(body.status).to.eql('PENDING_VERIFICATION'));",
                  "pm.test('timestamps are UTC ISO-8601', () => pm.expect(body.createdAt).to.match(/Z$/));",
                  "pm.collectionVariables.set('merchantId', body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Register merchant - duplicate email (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"businessName\": \"FreshBrew Again\",\n  \"email\": \"{{runEmail}}\",\n  \"country\": \"IN\",\n  \"defaultCurrency\": \"INR\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/merchants",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "merchants"
              ]
            },
            "description": "Reuses the email from 'Register merchant'. Run that request first."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
                  "pm.test('code', () => pm.expect(pm.response.json().code).to.eql('MERCHANT_EMAIL_ALREADY_EXISTS'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register merchant - blank fields (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"businessName\": \"\",\n  \"email\": \"\",\n  \"country\": \"\",\n  \"defaultCurrency\": \"\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/merchants",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "merchants"
              ]
            },
            "description": "Bean Validation failure: returns VALIDATION_FAILED with a populated fieldErrors map."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "const body = pm.response.json();",
                  "pm.test('code', () => pm.expect(body.code).to.eql('VALIDATION_FAILED'));",
                  "pm.test('reports every blank field', () => pm.expect(Object.keys(body.fieldErrors)).to.have.lengthOf(4));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register merchant - invalid country (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"businessName\": \"Bad Country Co\",\n  \"email\": \"owner@badcountry.example\",\n  \"country\": \"USA\",\n  \"defaultCurrency\": \"USD\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/merchants",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "merchants"
              ]
            },
            "description": "Domain invariant failure, which Bean Validation cannot express: returns INVALID_REQUEST with an empty fieldErrors map."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "const body = pm.response.json();",
                  "pm.test('code', () => pm.expect(body.code).to.eql('INVALID_REQUEST'));",
                  "pm.test('names the broken rule', () => pm.expect(body.message).to.eql('Country must be of length 2'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Identity & Auth",
      "description": "Registration, login, and rotating refresh tokens.\n\nRun the requests in order: each depends on tokens captured by the previous one. The reuse request deliberately revokes the whole family, so re-run from 'Register user' to get a working session again.",
      "item": [
        {
          "name": "Register user",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{authEmail}}\",\n  \"password\": \"correct-horse-battery-staple\",\n  \"merchantId\": \"{{merchantId}}\"\n}"
            },
            "description": "Attaches the user to the merchant registered above, granting MERCHANT_ADMIN scoped to it. That scope is what every request in 'Authenticated access' relies on."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('authEmail', 'owner+' + Date.now() + '@paymesh.example');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test('opaque prefixed id', () => pm.expect(b.id).to.match(/^usr_[0-9a-f-]{36}$/));",
                  "pm.test('starts active', () => pm.expect(b.status).to.eql('ACTIVE'));",
                  "pm.test('never echoes a password', () => pm.expect(JSON.stringify(b)).to.not.include('correct-horse'));",
                  "pm.test('scoped to the merchant just created', () => pm.expect(b.roles[0].merchantId).to.eql(pm.collectionVariables.get('merchantId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{authEmail}}\",\n  \"password\": \"correct-horse-battery-staple\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('bearer token type', () => pm.expect(b.tokenType).to.eql('Bearer'));",
                  "pm.test('access token is a three-part JWT', () => pm.expect(b.accessToken.split('.')).to.have.lengthOf(3));",
                  "pm.test('short-lived access token', () => pm.expect(b.expiresIn).to.eql(900));",
                  "pm.test('refresh token is opaque, not a JWT', () => pm.expect(b.refreshToken.split('.')).to.have.lengthOf(1));",
                  "pm.collectionVariables.set('accessToken', b.accessToken);",
                  "pm.collectionVariables.set('refreshToken', b.refreshToken);",
                  "pm.collectionVariables.set('firstRefreshToken', b.refreshToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - wrong password (401)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{authEmail}}\",\n  \"password\": \"definitely-not-the-password\"\n}"
            },
            "description": "The body here must be byte-identical to the unknown-email response below: a difference would let an attacker enumerate registered addresses."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('code', () => pm.expect(pm.response.json().code).to.eql('INVALID_CREDENTIALS'));",
                  "pm.collectionVariables.set('wrongPasswordBody', pm.response.text());"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - unknown email (401, identical body)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nobody-here@paymesh.example\",\n  \"password\": \"definitely-not-the-password\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('response is indistinguishable from a wrong password', () => pm.expect(pm.response.text()).to.eql(pm.collectionVariables.get('wrongPasswordBody')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Register - duplicate email (409)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{authEmail}}\",\n  \"password\": \"correct-horse-battery-staple\",\n  \"merchantId\": \"{{merchantId}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
                  "pm.test('code', () => pm.expect(pm.response.json().code).to.eql('USER_EMAIL_ALREADY_EXISTS'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh token (rotates)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/token/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "token",
                "refresh"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "description": "Spending a refresh token revokes it and mints a successor in the same family."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('a new refresh token was issued', () => pm.expect(b.refreshToken).to.not.eql(pm.collectionVariables.get('refreshToken')));",
                  "pm.collectionVariables.set('refreshToken', b.refreshToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh - reuse a spent token (401, revokes the family)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/token/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "token",
                "refresh"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{firstRefreshToken}}\"\n}"
            },
            "description": "Presenting an already-spent token means it leaked. There is no way to tell the thief from the victim, so the entire family is revoked and both are forced back through login. The next request proves the live successor died with it."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('code', () => pm.expect(pm.response.json().code).to.eql('INVALID_REFRESH_TOKEN'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh - successor is dead too (401)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/token/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "token",
                "refresh"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "description": "This token was valid a moment ago. Reuse detection revoked the whole lineage."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('code', () => pm.expect(pm.response.json().code).to.eql('INVALID_REFRESH_TOKEN'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "logout"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "description": "Idempotent: an unknown or already-revoked token is a silent no-op, so logout cannot be used to probe whether a token is still live."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 No Content', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Authenticated access",
      "description": "Everything that requires a bearer token. Run 'Merchant (public onboarding)' and 'Identity & Auth' first -- these use the access token captured by Login.\n\nThe cross-tenant requests build a second, unrelated merchant and user to prove that one tenant cannot see another's data.",
      "item": [
        {
          "name": "Get merchant - no token (401)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/merchants/{{merchantId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "merchants",
                "{{merchantId}}"
              ]
            },
            "description": "Reading a merchant is not public, even though creating one is."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('code', () => pm.expect(pm.response.json().code).to.eql('UNAUTHENTICATED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get merchant - forged token (401)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/merchants/{{merchantId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "merchants",
                "{{merchantId}}"
              ]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{forgedToken}}"
              }
            ],
            "description": "A structurally valid JWT carrying the right claims but signed with the wrong key. The filter chain verifies the signature, so claims alone buy nothing."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get merchant - own (200)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/merchants/{{merchantId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "merchants",
                "{{merchantId}}"
              ]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('is the caller\\'s merchant', () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('merchantId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create customer",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/customers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "customers"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"Buyer@Example.Test\",\n  \"merchantReference\": \"  order-42  \",\n  \"name\": \"  Jamie Buyer  \"\n}"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "description": "There is no merchantId field in this body. The tenant comes from the token, which is what makes writing under someone else's merchant impossible rather than merely discouraged."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.test('opaque prefixed id', () => pm.expect(b.id).to.match(/^cus_[0-9a-f-]{36}$/));",
                  "pm.test('tenant taken from the token', () => pm.expect(b.merchantId).to.eql(pm.collectionVariables.get('merchantId')));",
                  "pm.test('email lowercased', () => pm.expect(b.email).to.eql('buyer@example.test'));",
                  "pm.test('reference trimmed', () => pm.expect(b.merchantReference).to.eql('order-42'));",
                  "pm.test('lookup hashes are never exposed', () => { const s = JSON.stringify(b); pm.expect(s).to.not.include('emailHash'); pm.expect(s).to.not.include('phoneHash'); });",
                  "pm.collectionVariables.set('customerId', b.id);"
                ]
              }
            }
          ]
        },
