<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath/>
	</parent>

	<!-- A SEPARATE DEPLOYABLE, NOT A MODULE OF backend (ADR-041, the PR-6 pilot). It is the
	     first capability to actually LEAVE the monolith process, chosen because ADR-017 already
	     built it with zero references to PayMesh in either direction: it writes no PayMesh table,
	     imports no other capability, and its only influence on PayMesh is an HTTP POST of a signed
	     body at a callback route, exactly what a third party's would be. Lifting it into its own
	     module is therefore a MOVE, not a rewrite: the package (com.paymesh.simulator) is unchanged,
	     only its pom, its datasource and its main class are new. Build it with its own `./mvnw`
	     here, same pattern as `gateway/`. -->
	<groupId>com.paymesh</groupId>
	<artifactId>provider-sim</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>provider-sim</name>
	<description>PayMesh provider simulator: the fake payment provider, extracted (ADR-041)</description>

	<properties>
		<java.version>21</java.version>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<!-- Persistence: this module's own schema (`simulator`), its own Flyway history, no
		     other capability's tables. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
		</dependency>

		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-flyway</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Stands in for "PayMesh" on the receiving end of a callback, the way the
		     gateway's tests stand WireMock in for the monolith. SimulatorCallbackDeliveryIntegrationTest
		     used to run inside the monolith and drive a real payment intent to SUCCEEDED; extracted, this
		     module can no longer compile Payment's classes, so the receiver is stubbed and the test
		     asserts what THIS module is responsible for: correct signing, correct retry/dedup/ordering
		     handling of the response. Same version gateway pins. -->
		<dependency>
			<groupId>org.wiremock</groupId>
			<artifactId>wiremock-standalone</artifactId>
			<version>3.13.0</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<!-- Same reason as backend's: application.yaml ships no secrets, so a plain
					     `mvn spring-boot:run` refuses to start. -->
					<profiles>
						<profile>dev</profile>
					</profiles>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
